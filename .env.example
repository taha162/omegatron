# =============================================================================
# OmegaTron — environment variables
#
# Copy to `.env.local` for development, and add the same keys in the Vercel
# dashboard (Project → Settings → Environment Variables) for production.
#
# Only NEXT_PUBLIC_* values are exposed to the browser. RESEND_API_KEY is read
# exclusively inside the server-side API route and is never bundled for the
# client. Never commit a real `.env.local`.
# =============================================================================

# --- Email delivery (required for the project-request form) -------------------

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where project requests are delivered. Comma-separate for multiple recipients.
CONTACT_TO_EMAIL=you@example.com

# Verified sender. The domain must be verified in Resend, otherwise use
# `onboarding@resend.dev` while testing.
CONTACT_FROM_EMAIL=OmegaTron <requests@yourdomain.com>

# Optional silent copy.
# CONTACT_BCC_EMAIL=archive@example.com

# --- Site ---------------------------------------------------------------------

# Canonical production origin, no trailing slash. Used for canonical URLs,
# hreflang, sitemap.xml, and Open Graph. Falls back to the Vercel deployment URL.
NEXT_PUBLIC_SITE_URL=https://omegatron.example

# Optional. When set, this address is shown in the site footer.
# NEXT_PUBLIC_CONTACT_EMAIL=contact@yourdomain.com
